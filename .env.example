# Copier vers .env.local pour le développement (vercel dev), et renseigner les mêmes variables dans Vercel > Settings > Environment Variables.

# Supabase (Project Settings > API) : la clé secrète ne doit JAMAIS être exposée au navigateur
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Resend (resend.com > API Keys). Le domaine d'envoi doit être vérifié dans Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pour la Joie de Marie <contact@pourlajoiedemarie.com>
RESEND_REPLY_TO=contact@pourlajoiedemarie.com
RESEND_WEBHOOK_SECRET=

# Adresse publique du site (liens des emails)
SITE_URL=https://pourlajoiedemarie.com

# Secret du cron : Vercel l'envoie automatiquement à /api/relances (générer par ex. avec : openssl rand -hex 32)
CRON_SECRET=
